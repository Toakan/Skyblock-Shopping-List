{
	"schemaVersion": 1,
	"id": "skyblock-shopping-list",
	"version": "${version}",
	"name": "Skyblock Shopping List",
	"description": "Hypixel SkyBlock shopping-list HUD. Tracks the items in your inventory, sacks and storage, and shows what you still need for a chosen recipe. Read-only and client-side.",
	"authors": [
		"Tad"
	],
	"contributors": [
		"Scholiboi (original Inventory Reader)"
	],
	"contact": {
		"homepage": "https://github.com/Toakan/Skyblock-Shopping-List",
		"sources": "https://github.com/Toakan/Skyblock-Shopping-List",
		"issues": "https://github.com/Toakan/Skyblock-Shopping-List/issues"
	},
	"license": "CC-BY-SA-4.0",
	"icon": "assets/skyblock-shopping-list/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"inventoryreader.ir.InventoryReaderClient"
		]
	},
	"mixins": [
		"skyblock-shopping-list.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": ">=0.161.0"
	},
	"suggests": {
		"hypixel-mod-api": ">=1.0.2"
	},
	"breaks": {
		"ir": "*"
	}
}
