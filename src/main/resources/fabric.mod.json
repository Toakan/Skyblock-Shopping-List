{
	"schemaVersion": 1,
	"id": "ir",
	"version": "${version}",
	"name": "InventoryReader",
	"description": "Hypixel SkyBlock shopping-list HUD. Tracks the items in your inventory, sacks and storage, and shows what you still need for a chosen recipe. Read-only and client-side.",
	"authors": [
		"Scholiboi"
	],
	"contributors": [
		"Tad"
	],
	"contact": {
		"homepage": "https://github.com/Scholiboi/InventoryReader",
		"sources": "https://github.com/Scholiboi/InventoryReader",
		"issues": "https://github.com/Scholiboi/InventoryReader/issues"
	},
	"license": "CC-BY-SA-4.0",
	"icon": "assets/ir/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"inventoryreader.ir.InventoryReaderClient"
		]
	},
	"mixins": [
		"ir.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": ">=0.161.0"
	}
}
